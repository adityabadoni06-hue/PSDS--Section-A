class IntegerStack:
    def __init__(self):
        self.stack = []

    def push(self, item):
        self.stack.append(item)

    def pop(self):
        return self.stack.pop()

    def is_empty(self):
        return len(self.stack) == 0

def evaluate_postfix(expression):
    stack = IntegerStack()
    for ch in expression:
        if ch.isdigit():
            stack.push(int(ch))
        else:
            b = stack.pop()
            a = stack.pop()

            if ch == '+':
                result = a + b
            elif ch == '-':
                result = a - b
            elif ch == '*':
                result = a * b
            elif ch == '/':
                result = a / b
            elif ch == '^':
                result = a ** b

            stack.push(result)

    return stack.pop()

expression = input("Enter postfix expression:")
result = evaluate_postfix(expression)
print("Final mathematical output:", result)

