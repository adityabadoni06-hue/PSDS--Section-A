def difference_sum(a):
    return sum(abs(a[i] - a[i - 1]) for i in range(1, len(a)))


def arrange(a, c):
    s = sorted(a)
    p = sorted(range(len(a)), key=lambda i: c[i])
    r = [0] * len(a)

    for x, i in zip(s, p):
        r[i] = x

    return r


def maximize(a):
    n = len(a)

    if n <= 1:
        return a, 0

    candidates = []

    for start, end in [(-1, 1), (1, -1)]:
        c = [start]
        sign = end

        for _ in range(n - 2):
            c.append(2 * sign)
            sign *= -1

        c.append(end if n % 2 == 0 else start)
        candidates.append(arrange(a, c))

    best = max(candidates, key=difference_sum)
    return best, difference_sum(best)


n = int(input("Enter number of elements: "))
arr = list(map(int, input("Enter array: ").split()))

result, total = maximize(arr)

print("Rearranged Array:", result)
print("Maximum Sum:", total)



